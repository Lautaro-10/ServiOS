@{
    ViewData["Title"] = "Acceso a ServiOS";
    Layout = null; // Pantalla limpia sin la barra de navegación general
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center min-vh-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-4">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <h2 class="fw-bold text-primary">ServiOS</h2>
                            <p class="text-muted">Laboratorio de Microelectrónica y Servicio Técnico</p>
                        </div>

                        <form asp-action="Login" method="post">
                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                            <div class="mb-3">
                                <label class="form-label">Correo Electrónico</label>
                                <input type="email" name="email" class="form-control" required placeholder="admin@servios.com" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Contraseña</label>
                                <input type="password" name="password" class="form-control" required placeholder="••••••••" />
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 mt-2 fw-semibold">Ingresar al Sistema</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>