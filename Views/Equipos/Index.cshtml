@model IEnumerable<ServiOS.Models.Equipo>

@{
    ViewData["Title"] = "Equipos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Dispositivos en Taller</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo Dispositivo</a>
</div>

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Marca y Modelo</th>
            <th>IMEI / Nro. Serie</th>
            <th>Cliente (Dueño)</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td><strong>@item.Marca</strong> @item.Modelo</td>
            <td><code>@item.Imei</code></td>
            <td>@item.Cliente?.NombreCompleto (DNI: @item.Cliente?.Dni)</td>
            <td>
                @if(item.Activo) {
                    <span class="badge bg-success">Activo</span>
                } else {
                    <span class="badge bg-secondary">Inactivo</span>
                }
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>