@model ServiOS.Models.PaginacionRespuesta<ServiOS.Models.Pago>

@{
    ViewData["Title"] = "Registro de Pagos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Transacciones y Cobros</h2>
    <a asp-action="Create" class="btn btn-success">+ Registrar Pago</a>
</div>

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Fecha</th>
            <th>Orden / Equipo</th>
            <th>Cliente</th>
            <th>Concepto</th>
            <th>Importe</th>
            <th>Cobrado por</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Elementos) {
        <tr class="@(item.Anulado ? "text-decoration-line-through text-muted table-danger" : "")">
            <td>@item.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
            <td>Orden #@item.OrdenId (@item.Orden?.Equipo?.Marca @item.Orden?.Equipo?.Modelo)</td>
            <td>@item.Orden?.Equipo?.Cliente?.NombreCompleto</td>
            <td>@item.Concepto</td>
            <td><strong>$@item.Importe</strong></td>
            <td>@(item.UsuarioCobro != null ? $"{item.UsuarioCobro.Apellido}, {item.UsuarioCobro.Nombre}" : "-")</td>
            <td>
                @if (item.Anulado) {
                    <span class="badge bg-danger">Anulado</span>
                } else {
                    <span class="badge bg-success">Efectivo</span>
                }
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>
                @if (!item.Anulado) {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Anular</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted small">
        Página @Model.PaginaActual de @Math.Max(Model.TotalPaginas, 1) · @Model.TotalRegistros pago(s)
    </span>
    @if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Paginación de pagos">
            <ul class="pagination mb-0">
                <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                </li>
                @for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                {
                    <li class="page-item @(pagina == Model.PaginaActual ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@pagina">@pagina</a>
                    </li>
                }
                <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>