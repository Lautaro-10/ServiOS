@model ServiOS.Models.Pago

@{
    ViewData["Title"] = "Registrar Pago";
}

<div class="card shadow-sm mx-auto" style="max-width: 650px;">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0">Nuevo Cobro / Seña</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="OrdenId" class="form-label">Orden de Reparación</label>
                <select asp-for="OrdenId" class="form-select" asp-items="ViewBag.Ordenes">
                    <option value="">-- Seleccionar Orden --</option>
                </select>
                <span asp-validation-for="OrdenId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UsuarioCobroId" class="form-label">Empleado que recibe el pago</label>
                <select asp-for="UsuarioCobroId" class="form-select" asp-items="ViewBag.Usuarios">
                    <option value="">-- Seleccionar Usuario --</option>
                </select>
                <span asp-validation-for="UsuarioCobroId" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Importe" class="form-label"></label>
                    <input asp-for="Importe" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Importe" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FechaPago" class="form-label"></label>
                    <input asp-for="FechaPago" class="form-control" type="datetime-local" />
                    <span asp-validation-for="FechaPago" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Concepto" class="form-label"></label>
                <input asp-for="Concepto" class="form-control" placeholder="Ej: Seña módulo OLED, Cancelación de saldo..." />
                <span asp-validation-for="Concepto" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
                <button type="submit" class="btn btn-success">Registrar Transacción</button>
            </div>
        </form>
    </div>
</div>