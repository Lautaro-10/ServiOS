@model ServiOS.Models.PaginacionRespuesta<ServiOS.Models.OrdenReparacion>

@{
    ViewData["Title"] = "Órdenes de Reparación";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Órdenes de Servicio Técnico</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nueva Orden</a>
</div>

<form method="get" asp-action="Index" class="card card-body shadow-sm mb-4 bg-light">
    <div class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control" placeholder="Buscar por IMEI, Marca, Modelo, Cliente o DNI..." />
        </div>
        <div class="col-md-3">
            <select name="estado" class="form-select">
                <option value="">-- Todos los estados --</option>
                <option value="Recibido" selected="@(Model.EstadoFiltro == "Recibido")">Recibido</option>
                <option value="En Diagnóstico" selected="@(Model.EstadoFiltro == "En Diagnóstico")">En Diagnóstico</option>
                <option value="Esperando Repuesto" selected="@(Model.EstadoFiltro == "Esperando Repuesto")">Esperando Repuesto</option>
                <option value="Reparado" selected="@(Model.EstadoFiltro == "Reparado")">Reparado</option>
                <option value="Entregado" selected="@(Model.EstadoFiltro == "Entregado")">Entregado</option>
                <option value="Sin Solución" selected="@(Model.EstadoFiltro == "Sin Solución")">Sin Solución</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-dark w-50">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-50">Limpiar</a>
        </div>
    </div>
</form>

<table class="table table-striped table-hover shadow-sm align-middle">
    <thead class="table-dark">
        <tr>
            <th>Nro.</th>
            <th>Fecha</th>
            <th>Dispositivo</th>
            <th>Cliente</th>
            <th>Falla</th>
            <th>Estado</th>
            <th>Total</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@if (Model.Elementos.Any()) {
    @foreach (var item in Model.Elementos) {
        <tr>
            <td><strong>#@item.Id</strong></td>
            <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
            <td><strong>@item.Equipo?.Marca</strong> @item.Equipo?.Modelo</td>
            <td>@item.Equipo?.Cliente?.NombreCompleto</td>
            <td>@item.FallaDeclarada</td>
            <td>
                <span class="badge bg-primary">@item.Estado</span>
            </td>
            <td>$@item.CostoTotal</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
            </td>
        </tr>
    }
} else {
    <tr>
        <td colspan="8" class="text-center text-muted py-4">No se encontraron órdenes registradas con esos criterios.</td>
    </tr>
}
    </tbody>
</table>

@if (Model.TotalPaginas > 1) {
    <nav class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-muted small">
            Mostrando página @Model.PaginaActual de @Model.TotalPaginas (Total: @Model.TotalRegistros órdenes)
        </span>
        <ul class="pagination mb-0">
            <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : "")">
                <a class="page-link" asp-action="Index" 
                   asp-route-pagina="@(Model.PaginaActual - 1)" 
                   asp-route-busqueda="@Model.Busqueda" 
                   asp-route-estado="@Model.EstadoFiltro">Anterior</a>
            </li>

            @for (int i = 1; i <= Model.TotalPaginas; i++) {
                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-pagina="@i" 
                       asp-route-busqueda="@Model.Busqueda" 
                       asp-route-estado="@Model.EstadoFiltro">@i</a>
                </li>
            }

            <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : "")">
                <a class="page-link" asp-action="Index" 
                   asp-route-pagina="@(Model.PaginaActual + 1)" 
                   asp-route-busqueda="@Model.Busqueda" 
                   asp-route-estado="@Model.EstadoFiltro">Siguiente</a>
            </li>
        </ul>
    </nav>
}