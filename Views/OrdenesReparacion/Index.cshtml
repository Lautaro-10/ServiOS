@model IEnumerable<ServiOS.Models.OrdenReparacion>

@{
    ViewData["Title"] = "Órdenes de Reparación";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Órdenes de Servicio Técnico</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nueva Orden</a>
</div>

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Nro.</th>
            <th>Fecha</th>
            <th>Dispositivo</th>
            <th>Cliente</th>
            <th>Falla</th>
            <th>Estado</th>
            <th>Total</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td><strong>#@item.Id</strong></td>
            <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
            <td>@item.Equipo?.Marca @item.Equipo?.Modelo</td>
            <td>@item.Equipo?.Cliente?.NombreCompleto</td>
            <td>@item.FallaDeclarada</td>
            <td>
                <span class="badge bg-primary">@item.Estado</span>
            </td>
            <td>$@item.CostoTotal</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
            </td>
        </tr>
}
    </tbody>
</table>