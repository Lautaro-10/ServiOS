@model ServiOS.Models.OrdenReparacion

@{
    ViewData["Title"] = $"Editar Orden #{Model.Id}";
}

<div class="card shadow-sm mx-auto" style="max-width: 750px;">
    <div class="card-header bg-primary text-white"><h4 class="mb-0">Editar Orden #@Model.Id</h4></div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="EquipoId" class="form-label">Equipo y Dueño</label>
                <select asp-for="EquipoId" class="form-select" asp-items="ViewBag.Equipos">
                    <option value="">-- Seleccionar Equipo --</option>
                </select>
                <span asp-validation-for="EquipoId" class="text-danger"></span>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="TipoServicioId" class="form-label"></label>
                    <select asp-for="TipoServicioId" class="form-select" asp-items="ViewBag.TiposServicio">
                        <option value="">-- Seleccionar Rubro --</option>
                    </select>
                    <span asp-validation-for="TipoServicioId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="UsuarioTecnicoId" class="form-label"></label>
                    <select asp-for="UsuarioTecnicoId" class="form-select" asp-items="ViewBag.Tecnicos">
                        <option value="">-- Sin asignar --</option>
                    </select>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="FechaIngreso" class="form-label"></label>
                    <input asp-for="FechaIngreso" class="form-control" type="date" />
                    <span asp-validation-for="FechaIngreso" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FechaPrometida" class="form-label"></label>
                    <input asp-for="FechaPrometida" class="form-control" type="date" />
                    <span asp-validation-for="FechaPrometida" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="FechaEntregaReal" class="form-label"></label>
                <input asp-for="FechaEntregaReal" class="form-control" type="date" />
                <span asp-validation-for="FechaEntregaReal" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FallaDeclarada" class="form-label"></label>
                <input asp-for="FallaDeclarada" class="form-control" />
                <span asp-validation-for="FallaDeclarada" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DiagnosticoTecnico" class="form-label"></label>
                <textarea asp-for="DiagnosticoTecnico" class="form-control" rows="3"></textarea>
                <span asp-validation-for="DiagnosticoTecnico" class="text-danger"></span>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="CostoRepuestos" class="form-label"></label>
                    <input asp-for="CostoRepuestos" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="CostoRepuestos" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CostoManoObra" class="form-label"></label>
                    <input asp-for="CostoManoObra" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="CostoManoObra" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Estado" class="form-label"></label>
                    <select asp-for="Estado" class="form-select" asp-items="ViewBag.Estados"></select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
                <button type="submit" class="btn btn-success">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
