@{
    ViewData["Title"] = "Clientes";
}

<div id="clientes-app">
    @Html.AntiForgeryToken()
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0">Clientes</h2>
        <button type="button" class="btn btn-primary" v-on:click="nuevoCliente">+ Nuevo cliente</button>
    </div>

    <div v-if="mensaje" class="alert" v-bind:class="error ? 'alert-danger' : 'alert-success'" role="alert">
        {{ mensaje }}
    </div>

    <section v-if="formularioVisible" class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h3 class="h5 mb-0">{{ editando ? 'Editar cliente' : 'Registrar cliente' }}</h3>
        </div>
        <div class="card-body">
            <form v-on:submit.prevent="guardar">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="cliente-dni" class="form-label">DNI</label>
                        <input id="cliente-dni" v-model.trim="form.dni" class="form-control" maxlength="15" required />
                        <div v-if="errores.dni" class="text-danger small">{{ errores.dni }}</div>
                    </div>
                    <div class="col-md-4">
                        <label for="cliente-nombre" class="form-label">Nombre</label>
                        <input id="cliente-nombre" v-model.trim="form.nombre" class="form-control" maxlength="50" required />
                        <div v-if="errores.nombre" class="text-danger small">{{ errores.nombre }}</div>
                    </div>
                    <div class="col-md-4">
                        <label for="cliente-apellido" class="form-label">Apellido</label>
                        <input id="cliente-apellido" v-model.trim="form.apellido" class="form-control" maxlength="50" required />
                        <div v-if="errores.apellido" class="text-danger small">{{ errores.apellido }}</div>
                    </div>
                    <div class="col-md-6">
                        <label for="cliente-telefono" class="form-label">Teléfono</label>
                        <input id="cliente-telefono" v-model.trim="form.telefono" class="form-control" maxlength="50" type="tel" />
                        <div v-if="errores.telefono" class="text-danger small">{{ errores.telefono }}</div>
                    </div>
                    <div class="col-md-6">
                        <label for="cliente-email" class="form-label">Email</label>
                        <input id="cliente-email" v-model.trim="form.email" class="form-control" maxlength="100" type="email" />
                        <div v-if="errores.email" class="text-danger small">{{ errores.email }}</div>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="button" class="btn btn-outline-secondary" v-on:click="cancelar">Cancelar</button>
                    <button type="submit" class="btn btn-success" v-bind:disabled="guardando">
                        {{ guardando ? 'Guardando...' : (editando ? 'Guardar cambios' : 'Crear cliente') }}
                    </button>
                </div>
            </form>
        </div>
    </section>

    <section class="card shadow-sm">
        <div class="card-header bg-light">
            <form class="row g-2" v-on:submit.prevent="buscar">
                <div class="col">
                    <label for="busqueda-clientes" class="visually-hidden">Buscar clientes</label>
                    <input id="busqueda-clientes" v-model.trim="busqueda" class="form-control"
                           placeholder="Buscar por DNI, nombre, apellido, teléfono o email" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-dark">Buscar</button>
                    <button type="button" class="btn btn-outline-secondary ms-1" v-on:click="limpiarBusqueda">Limpiar</button>
                </div>
            </form>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>DNI</th>
                        <th>Apellido y nombre</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-if="cargando">
                        <td colspan="5" class="text-center py-4">Cargando clientes...</td>
                    </tr>
                    <tr v-else-if="clientes.length === 0">
                        <td colspan="5" class="text-center text-muted py-4">No hay clientes para mostrar.</td>
                    </tr>
                    <tr v-for="cliente in clientes" v-bind:key="cliente.id">
                        <td>{{ cliente.dni }}</td>
                        <td>{{ cliente.apellido }}, {{ cliente.nombre }}</td>
                        <td>{{ cliente.telefono || '-' }}</td>
                        <td>{{ cliente.email || '-' }}</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-warning" v-on:click="editar(cliente)">Editar</button>
                            <button type="button" class="btn btn-sm btn-danger ms-1" v-on:click="eliminar(cliente)">Eliminar</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="text-muted small">
                {{ totalRegistros }} cliente(s) · Página {{ paginaActual }} de {{ Math.max(totalPaginas, 1) }}
            </span>
            <div class="btn-group">
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        v-bind:disabled="paginaActual <= 1 || cargando" v-on:click="cambiarPagina(paginaActual - 1)">
                    Anterior
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        v-bind:disabled="paginaActual >= totalPaginas || cargando" v-on:click="cambiarPagina(paginaActual + 1)">
                    Siguiente
                </button>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/lib/vue/vue.global.prod.js"></script>
    <script src="~/js/clientes.js" asp-append-version="true"></script>
}
