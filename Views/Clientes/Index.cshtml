@model IEnumerable<ServiOS.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Clientes Registrados</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo Cliente</a>
</div>

<table class="table table-striped table-hover shadow-sm rounded">
    <thead class="table-dark">
        <tr>
            <th>DNI</th>
            <th>Nombre Completo</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Dni</td>
            <td>@item.NombreCompleto</td>
            <td>@(item.Telefono ?? "-")</td>
            <td>@(item.Email ?? "-")</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>