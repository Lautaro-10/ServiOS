@model ServiOS.Models.Cliente

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<div class="card shadow-sm mx-auto" style="max-width: 600px;">
    <div class="card-header bg-danger text-white"><h4 class="mb-0">Eliminar cliente</h4></div>
    <div class="card-body">
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        <p>¿Confirmás la eliminación de <strong>@Model.NombreCompleto</strong> (DNI: @Model.Dni)?</p>
        <p class="text-danger">La operación puede ser rechazada si el cliente tiene equipos asociados.</p>
        <form asp-action="Delete" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-danger">Eliminar cliente</button>
            </div>
        </form>
    </div>
</div>
